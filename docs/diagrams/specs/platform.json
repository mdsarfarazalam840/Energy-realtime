{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "VoltScope Platform Data Flow",
    "output": "docs/diagrams/platform.html",
    "quality_profile": "showcase",
    "viewBox": [
      1080,
      780
    ],
    "views": [
      {
        "id": "streaming-lanes",
        "label": "Streaming lanes",
        "focus": [
          "market",
          "coingecko",
          "adsblol",
          "energy-producers",
          "crypto-producer",
          "flights-snapshot",
          "kafka",
          "databricks",
          "delta"
        ],
        "note": "Three topics share one Kafka cluster; each Databricks notebook drains its own topic with availableNow."
      },
      {
        "id": "serving",
        "label": "Serving",
        "focus": [
          "delta",
          "exporters",
          "artifacts",
          "pages",
          "browsers"
        ],
        "note": "Exporters read the lakehouse over SQL, commit JSON to docs/data, and Pages serves it with no token in the page."
      },
      {
        "id": "edge-caches",
        "label": "Edge caches",
        "focus": [
          "publics",
          "cache-jobs",
          "artifacts",
          "pages"
        ],
        "note": "Finance, Tech Pulse, AI trends, and Space ship cached JSON instead of a streaming table, alongside the flights map snapshot."
      },
      {
        "id": "mirrors",
        "label": "Flights mirror",
        "focus": [
          "adsblol",
          "flights-snapshot",
          "kafka",
          "motherduck"
        ],
        "note": "One adsb.lol grid pass writes flights.json and produces flights-positions; the bridge mirrors that topic into MotherDuck."
      }
    ]
  },
