    {
      "dot": "emerald",
      "title": "One Lakehouse, One Mirror",
      "items": [
        "Each notebook drains its topic with availableNow",
        "Delta keeps append-only history under Unity Catalog",
        "The flights bridge upserts the same topic into MotherDuck"
      ]
    },
